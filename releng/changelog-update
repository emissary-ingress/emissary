#!/usr/bin/env python3
"""Assemble the changelog snippets in docs/changes/ into CHANGELOG.md.

Usage: releng/changelog-update X.Y.Z[-rc.N]

Any existing "X.Y.Z-rc.*" sections are removed from CHANGELOG.md first, and
then the whole section for the requested version is rebuilt from the snippets.

 - For an RC, the snippets are kept, so the next RC (or the GA) can rebuild
   the section including everything that has landed since.
 - For a GA (no -rc suffix), the snippets are consumed (deleted), and the RC
   sections are gone: only the GA section remains.

Run this with `uv run --dev` so that towncrier is available.
"""

import datetime
import re
import subprocess
import sys

CHANGELOG = "CHANGELOG.md"
VERSION_RE = re.compile(r"^(\d+\.\d+\.\d+)(-rc\.\d+)?$")


def strip_rc_sections(text: str, base: str) -> str:
    """Remove every `## [base-rc.N] ...` section, up to the next `## ` heading."""
    heading = re.compile(rf"^## \[{re.escape(base)}-rc\.\d+\]")
    out = []
    skipping = False
    for line in text.splitlines(keepends=True):
        if line.startswith("## "):
            skipping = bool(heading.match(line))
        if not skipping:
            out.append(line)
    return "".join(out)


def run_towncrier(version: str, is_rc: bool) -> int:
    today = datetime.date.today()
    cmd = [
        sys.executable,
        "-m",
        "towncrier",
        "build",
        "--version",
        version,
        "--date",
        f"{today.day} {today:%B %Y}",
        "--keep" if is_rc else "--yes",
    ]
    return subprocess.run(cmd, check=False).returncode


def update(path: str, version: str) -> int:
    """Rebuild the section for `version` in the changelog at `path`.

    If anything goes wrong (towncrier fails, or we're interrupted), the
    changelog is restored to exactly what it was. towncrier itself only
    deletes snippets after it has written the changelog successfully, so a
    failure leaves the snippets in place too.
    """
    m = VERSION_RE.match(version)
    if not m:
        print(__doc__, file=sys.stderr)
        print("ERROR: version must look like X.Y.Z or X.Y.Z-rc.N", file=sys.stderr)
        return 2

    base, is_rc = m.group(1), m.group(2) is not None

    with open(path, encoding="utf-8", newline="") as f:
        original = f.read()

    ok = False
    try:
        with open(path, "w", encoding="utf-8", newline="") as f:
            f.write(strip_rc_sections(original, base))
        rc = run_towncrier(version, is_rc)
        ok = rc == 0
        return rc
    finally:
        if not ok:
            with open(path, "w", encoding="utf-8", newline="") as f:
                f.write(original)
            print(f"ERROR: failed; {path} restored to its original contents", file=sys.stderr)


def main() -> int:
    if len(sys.argv) != 2:
        print(__doc__, file=sys.stderr)
        return 2
    return update(CHANGELOG, sys.argv[1])


if __name__ == "__main__":
    sys.exit(main())
